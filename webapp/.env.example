# Copy to .env.local (gitignored) and adjust for your environment.

# GeoServer WMS base URL. Defaults to the production placeholder in
# src/stores/mapStore.ts if unset. Point this at the local demo GeoServer
# to develop against it — see demo-geoserver/README.md.
VITE_GEOSERVER_URL=http://localhost:8080/geoserver/MSPudhu/wms

# Copy to .env.local (gitignored) and adjust for your environment.

# GeoServer base URL (no workspace, no /wms — each request adds its own
# workspace). Defaults to the production placeholder in
# src/stores/mapStore.ts if unset. Point this at the local demo GeoServer
# to develop against it — see demo-geoserver/README.md.
VITE_GEOSERVER_URL=http://localhost:8080/geoserver

# Nav config as a JSON string (shape: NavFile in src/stores/configStore.ts).
# Baked in at build time. Unset uses the default nav tree embedded in
# src/stores/configStore.ts (DEFAULT_NAV_CONFIG) — only set this to ship a
# different nav tree without a source change.
# VITE_NAV_CONFIG={"dataRepository":{"layer":"MSPudhu:DataRepository","submenus":["MSPudhu:Environment","MSPudhu:Ecology","MSPudhu:Human_Activities","MSPudhu:Socio_Economic"]},"status indicators":{"layer":"MSPudhu:StatusIndicators"},"conflicts":{"layer":"MSPudhu:Conflicts"},"services":{"layer":"MSPudhu:Services"},"lakshadweep":{"layer":"MSPLak:Boundaries"}}

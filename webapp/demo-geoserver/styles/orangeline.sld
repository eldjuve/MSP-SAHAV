<?xml version='1.0' encoding='UTF-8'?>
<StyledLayerDescriptor xmlns="http://www.opengis.net/sld" version="1.0.0"><NamedLayer>
        <Name>MSPudhu:GraveYard_Boundary</Name>
        <UserStyle>
            <Name>orangeline</Name>
            <Title>A orange line style</Title>
            <IsDefault>1</IsDefault>
            <FeatureTypeStyle>
                <Name>name</Name>
                <Rule>
                    <Title>orange line</Title>
                    <LineSymbolizer>
                        <Stroke>
                            <CssParameter name="stroke">#ff9e17</CssParameter>
                        <CssParameter name="stroke-opacity">1</CssParameter></Stroke>
                    </LineSymbolizer>
                </Rule>
            </FeatureTypeStyle>
        </UserStyle>
    </NamedLayer>
    </StyledLayerDescriptor>
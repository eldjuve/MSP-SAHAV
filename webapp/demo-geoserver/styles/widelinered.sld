<?xml version='1.0' encoding='UTF-8'?>
<StyledLayerDescriptor xmlns="http://www.opengis.net/sld" version="1.0.0"><NamedLayer>
        <Name>MSPudhu:Open_Drain</Name>
        <UserStyle>
            <Name>widelinered</Name>
            <IsDefault>1</IsDefault>
            <FeatureTypeStyle>
                <Name>name</Name>
                <Rule>
                    <Name />
                    <LineSymbolizer>
                        <Stroke>
                            <CssParameter name="stroke">#be3a29</CssParameter>
                            <CssParameter name="stroke-linecap">square</CssParameter>
                            <CssParameter name="stroke-linejoin">bevel</CssParameter>
                            <CssParameter name="stroke-width">7</CssParameter>
                        <CssParameter name="stroke-opacity">1</CssParameter></Stroke>
                    </LineSymbolizer>
                </Rule>
            </FeatureTypeStyle>
        </UserStyle>
    </NamedLayer>
    </StyledLayerDescriptor>
<?xml version='1.0' encoding='UTF-8'?>
<StyledLayerDescriptor xmlns="http://www.opengis.net/sld" version="1.0.0"><NamedLayer>
        <Name>MSPudhu:Rail_Broadgauge</Name>
        <UserStyle>
            <Name>simple_roads</Name>
            <Title>Red Line</Title>
            <IsDefault>1</IsDefault>
            <Abstract>Light red line, 2px wide</Abstract>
            <FeatureTypeStyle>
                <Name>name</Name>
                <Rule>
                    <Title>Roads</Title>
                    <LineSymbolizer>
                        <Stroke>
                            <CssParameter name="stroke">#AA3333</CssParameter>
                            <CssParameter name="stroke-width">2</CssParameter>
                        </Stroke>
                    </LineSymbolizer>
                </Rule>
            </FeatureTypeStyle>
        </UserStyle>
    </NamedLayer>
    </StyledLayerDescriptor>
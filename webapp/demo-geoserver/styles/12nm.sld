<?xml version='1.0' encoding='UTF-8'?>
<StyledLayerDescriptor xmlns="http://www.opengis.net/sld" version="1.0.0"><NamedLayer>
        <Name>MSPudhu:Multi_Hazard_Line</Name>
        <UserStyle>
            <Name>12nm</Name>
            <Title>Red Line</Title>
            <IsDefault>1</IsDefault>
            <Abstract>Light red line, 2px wide</Abstract>
            <FeatureTypeStyle>
                <Name>name</Name>
                <Rule>
                    <Title>Roads</Title>
                    <LineSymbolizer>
                        <Stroke>
                            <CssParameter name="stroke">#163cdc</CssParameter>
                            <CssParameter name="stroke-width">3</CssParameter>
                        <CssParameter name="stroke-opacity">1</CssParameter></Stroke>
                    </LineSymbolizer>
                </Rule>
            </FeatureTypeStyle>
        </UserStyle>
    </NamedLayer>
    </StyledLayerDescriptor>
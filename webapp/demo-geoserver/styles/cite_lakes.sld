<?xml version='1.0' encoding='UTF-8'?>
<StyledLayerDescriptor xmlns="http://www.opengis.net/sld" version="1.0.0"><NamedLayer>
        <Name>MSPudhu:Beaches</Name>
        <UserStyle>
            <Name>cite_lakes</Name>
            <Title>Blue lake</Title>
            <IsDefault>1</IsDefault>
            <Abstract>A blue fill, solid black outline style</Abstract>
            <FeatureTypeStyle>
                <Name>name</Name>
                <Rule>
                    <Name>name</Name>
                    <PolygonSymbolizer>
                        <Fill>
                            <CssParameter name="fill">#4040C0</CssParameter>
                        </Fill>
                        <Stroke />
                    </PolygonSymbolizer>
                </Rule>
            </FeatureTypeStyle>
        </UserStyle>
    </NamedLayer>
    </StyledLayerDescriptor>